---
import Base from "../../layouts/Base.astro";
import World from "../../components/World.astro";
import WorldSymbol from "../../components/WorldSymbol.astro";
import { publishedJournal, publishedUpdates } from "../../lib/content";
import { BABYNAMING_URL, BRAND, formatDate, isoDate, KIDS_URL, SITE, SOCIAL_IMAGE, TAGLINE } from "../../lib/site";

const [article] = await publishedJournal();
const [update] = await publishedUpdates();
const title = `${BRAND} | ${TAGLINE}`;
const description = "A digital companion for families, from preparing for your baby’s arrival to discovering the world together as your child grows.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND,
  url: `${SITE}/en/`,
  logo: SOCIAL_IMAGE,
};
---
<Base title={BRAND} exactTitle={title} description={description} path="/en/" jsonLd={jsonLd}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="eyebrow">{TAGLINE}</p>
      <h1 id="hero-title">Petit Mokus is a digital companion for families, from preparing for your baby’s arrival to discovering the world together as your child grows.</h1>
      <p class="lead">For the moments before they arrive, and all the little discoveries that follow.</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <img src="/brand/petitmokus-logo-color.svg" alt="" width="220" height="220" />
      <svg class="hero-trail" viewBox="0 0 200 120" width="200" height="120" focusable="false">
        <path d="M100 4 C 150 24, 160 60, 100 76 S 60 104, 100 118" />
      </svg>
    </div>
    <ul class="cue" aria-label="The three Petit Mokus worlds">
      <li>
        <a class="tile tile-babynaming" href={BABYNAMING_URL}>
          <WorldSymbol world="babynaming" size={72} />
          <span class="tile-name">BabyNaming</span>
          <span class="tile-status">Live</span>
        </a>
      </li>
      <li>
        <a class="tile tile-kids" href={KIDS_URL}>
          <WorldSymbol world="kids" size={72} />
          <span class="tile-name">Kids</span>
          <span class="tile-status">Live</span>
        </a>
      </li>
      <li>
        <span class="tile tile-cotton tile-soon">
          <WorldSymbol world="cotton" size={72} />
          <span class="tile-name">Cotton Club</span>
          <span class="tile-status">Coming soon</span>
        </span>
      </li>
    </ul>
    <p class="hero-more"><a class="hero-action" href="#worlds">Explore our little worlds <span aria-hidden="true">↓</span></a></p>
  </section>

  <section class="worlds wrap" id="worlds" aria-labelledby="worlds-title">
    <h2 id="worlds-title">One family, three little worlds</h2>
    <div class="path">
      <svg class="path-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path vector-effect="non-scaling-stroke" d="M50 0 C 96 6, 96 28, 50 34 S 4 60, 50 67 S 96 94, 50 100" />
      </svg>
      <ol class="stops">
        <World world="babynaming" id="world-babynaming" label="Before they arrive" name="Petit Mokus BabyNaming" status="Live" href={BABYNAMING_URL} cta="Open BabyNaming">
          Choose your baby’s name together, as two parents.
        </World>
        <World world="kids" id="world-kids" label="As they grow" name="Petit Mokus Kids" status="Live" href={KIDS_URL} cta="Open Kids">
          Sounds, lullabies and simple games to enjoy together.
        </World>
        <World world="cotton" id="world-cotton" label="For everyday adventures" name="Petit Mokus Cotton Club" status="Coming soon">
          Natural materials for little everyday adventures. A small collection is taking shape.
        </World>
      </ol>
    </div>
  </section>

  <section class="story" id="our-story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="story-head">
        <h2 id="story-title">Our story</h2>
        <p class="story-lead">It began at home.</p>
      </div>
      <div class="story-text">
        <p>Petit Mokus is multicultural at its core, crafted by a French-Hungarian family in Amsterdam.</p>
        <p>Mokus means squirrel in Hungarian: a small, curious animal that thrives through play, exploration, and a love of small, meaningful moments.</p>
        <p>Like a little squirrel gathering nuts, Petit Mokus brings together gentle interactions for family life, one small moment at a time.</p>
      </div>
    </div>
  </section>

  <section class="journal wrap narrow" aria-labelledby="journal-title">
    <h2 id="journal-title">From the Journal</h2>
    <p class="muted">Guides and product stories for parents and families.</p>
    <ul class="rows">
      {article && (
        <li>
          <a class="row" href={`/en/journal/${article.id}/`}>
            <span class="row-kind">Article</span>
            <span class="row-title">{article.data.title}</span>
            <time class="muted" datetime={isoDate(article.data.publishedAt)}>{formatDate(article.data.publishedAt)}</time>
          </a>
        </li>
      )}
      {update && (
        <li>
          <a class="row" href={`/en/updates/${update.id}/`}>
            <span class="row-kind">Update</span>
            <span class="row-title">{update.data.title}</span>
            <time class="muted" datetime={isoDate(update.data.publishedAt)}>{formatDate(update.data.publishedAt)}</time>
          </a>
        </li>
      )}
    </ul>
    <p><a class="pill pill-outline" href="/en/journal/">Read the Journal</a></p>
  </section>
</Base>
