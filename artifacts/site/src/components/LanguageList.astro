---
import { type Locale, UI } from "../lib/i18n";
import { LANGUAGES } from "../lib/site";

// `hrefs` sends a language to the same page in that language (a Journal
// article's versions); every other language goes to its homepage or Kids.
const { locale = "en", hrefs = {} } = Astro.props as { locale?: Locale; hrefs?: Record<string, string> };
---
<p class="lang-note muted">{UI[locale].languageNote}</p>
<ul class="lang-list">
  {LANGUAGES.map((l) => (
    <li>
      <a href={hrefs[l.code] ?? l.href} lang={l.code} hreflang={l.code} aria-current={l.code === locale ? "true" : undefined}>{l.native}</a>
    </li>
  ))}
</ul>
