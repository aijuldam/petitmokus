---
import "../styles/global.css";
import LanguageList from "../components/LanguageList.astro";
import { type Locale, UI } from "../lib/i18n";
import { absolute, BABYNAMING_URL, BRAND, homeUrl, kidsUrl as kidsUrlFor, SOCIAL_IMAGE, TAGLINE } from "../lib/site";

interface Props {
  title: string;
  /** Used as the whole title when a page should not get the brand suffix. */
  exactTitle?: string;
  description: string;
  /** Site-relative path of this page, used for the canonical URL. */
  path: string;
  ogType?: "website" | "article";
  /** For pages that must never be indexed, such as the 404 page. */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** The page language: English, or one of the other homepage languages. */
  locale?: Locale;
  /** The same page in other languages (hreflang), when there is one. */
  alternates?: { hreflang: string; href: string }[];
}
const { title, exactTitle, description, path, ogType = "website", noindex = false, jsonLd, locale = "en", alternates = [] } = Astro.props;
const t = UI[locale];
const journalUrl = `/${locale}/journal/`;
// Every language has its homepage at /<locale>/ and Kids at /<locale>/kids/.
const homeHref = homeUrl(locale);
const kidsUrl = kidsUrlFor(locale);
const canonical = absolute(path);
const fullTitle = exactTitle ?? (title === BRAND ? title : `${title} · ${BRAND}`);
const inJournal = path.startsWith(journalUrl) || path.startsWith("/en/updates/");
const links = [
  { href: kidsUrl, label: "Kids" },
  { href: BABYNAMING_URL, label: "BabyNaming" },
  { href: journalUrl, label: t.journal, current: inJournal },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F9F6F1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={SOCIAL_IMAGE} />
    <meta name="twitter:card" content="summary" />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={homeHref} aria-label={t.brandHome}>
          <img src="/brand/petitmokus-logo-color.svg" alt="" width="48" height="48" />
          <span>
            <span class="brand-name">{BRAND}</span>
            <span class="brand-tagline">{TAGLINE}</span>
          </span>
        </a>
        <div class="header-nav">
          <nav aria-label={t.main}>
            <ul class="nav-links">
              {links.map((l) => <li><a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a></li>)}
            </ul>
          </nav>
          <details class="disclosure lang">
            <summary aria-label={t.languageLabel}>{locale.toUpperCase()}</summary>
            <div class="panel"><LanguageList locale={locale} /></div>
          </details>
          <details class="disclosure menu">
            <summary>{t.menu}</summary>
            <nav class="panel" aria-label={t.main}>
              <ul class="nav-links">
                {links.map((l) => <li><a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a></li>)}
                <li><a href="#languages">{t.languages}</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label={t.footer}>
          <ul class="footer-links">
            <li><a href={homeHref}>{t.home}</a></li>
            <li><a href={kidsUrl}>Kids</a></li>
            <li><a href={BABYNAMING_URL}>BabyNaming</a></li>
            <li><a href={journalUrl}>{t.journal}</a></li>
          </ul>
        </nav>
        <details class="disclosure footer-lang" id="languages">
          <summary>{t.languages}</summary>
          <div class="panel"><LanguageList locale={locale} /></div>
        </details>
      </div>
    </footer>
    <!--
      The header menus and the footer language list are plain <details>
      elements and work without this script. It only adds what <details>
      lacks: Escape to close with focus back on the trigger, an accurate
      aria-expanded, closing a header menu after one of its links is
      followed, and opening the footer language list when it is the target
      of a link.
    -->
    <script is:inline>
      for (const menu of document.querySelectorAll("details.disclosure")) {
        const trigger = menu.querySelector("summary");
        const sync = () => trigger.setAttribute("aria-expanded", String(menu.open));
        sync();
        // Observing the attribute keeps aria-expanded right as soon as the
        // state changes; the toggle event only fires a task later.
        new MutationObserver(sync).observe(menu, { attributes: true, attributeFilter: ["open"] });
        menu.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          menu.open = false;
          trigger.focus();
        });
        if (menu.closest(".site-header")) {
          menu.addEventListener("click", (event) => {
            if (event.target.closest(".panel a")) menu.open = false;
          });
        }
      }
      const languages = document.getElementById("languages");
      const openLanguages = () => {
        if (location.hash !== "#languages" || !languages) return;
        languages.open = true;
        languages.querySelector("summary").focus();
      };
      addEventListener("hashchange", openLanguages);
      openLanguages();
    </script>
  </body>
</html>
