---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { publishedUpdates } from "../../../lib/content";
import { BABYNAMING_URL, formatDate, isoDate, KIDS_URL } from "../../../lib/site";

export async function getStaticPaths() {
  const updates = await publishedUpdates();
  return updates.map((update) => ({ params: { slug: update.id }, props: { update } }));
}

const { update } = Astro.props;
const { Content } = await render(update);
const published = update.data.publishedAt;
const product =
  update.data.relatedProduct === "babynaming"
    ? { href: BABYNAMING_URL, label: "Petit Mokus BabyNaming" }
    : update.data.relatedProduct === "kids"
      ? { href: KIDS_URL, label: "Petit Mokus Kids" }
      : null;
---
<Base title={update.data.title} description={update.data.description} path={`/en/updates/${update.id}/`} ogType="article">
  <article class="wrap narrow article">
    <header class="page-head">
      <p class="meta"><a href="/en/updates/">Updates</a></p>
      <h1>{update.data.title}</h1>
      <p class="meta muted"><time datetime={isoDate(published)}>{formatDate(published)}</time></p>
    </header>
    <Content />
    {product && <p style="margin-top:2rem"><a class="pill" href={product.href}>Open {product.label}</a></p>}
  </article>
</Base>
