---
// Product symbols for the Petit Mokus worlds, drawn from lib/symbols.ts (the
// same data as the published /suite/symbols.svg sprite). They are always
// decorative, because the product name is written next to them.
import { shapesFor, type SymbolId } from "../lib/symbols";

interface Props {
  world: SymbolId;
  /** "simple" for 24px uses; "full" adds the finer lines from 48px up. */
  detail?: "simple" | "full";
  size?: number;
}
const { world, detail = "full", size = 96 } = Astro.props;
const shapes = shapesFor(world, detail);
---
<svg class:list={["world-symbol", `world-symbol-${world}`]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  <g>
    {shapes.map((s) => {
      const Tag = s.tag;
      return <Tag class={s.cls} {...s.attrs} />;
    })}
  </g>
</svg>
